# Claude API（未設定でも定型文で動く）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# LINE Messaging API（LINE Developers のチャネル設定から）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Stripe（未設定なら課金ボタンは無効）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# 公開URL（Stripe の戻り先に使う）
PUBLIC_URL=http://localhost:8000

# 回数制限
FREE_DAILY_LIMIT=1
PREMIUM_DAILY_LIMIT=10

DB_PATH=uranai.db
